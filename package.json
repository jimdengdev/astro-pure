    "@waline/client": "^3.15.2",
    "astro": "6.4.8",
    "astro-pure": "1.4.9",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "three": "0.180.0",
    "twikoo": "^2.0.12",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/three": "0.180.0",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
