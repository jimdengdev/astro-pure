---
/**
 * Local override of `astro-pure/components/pages` Hero.
 *
 * Differences from the upstream version:
 * - Cover image is horizontally centered (upstream left-aligns a max-w-[65ch] image
 *   inside a wider column, which looks off-center).
 * - The heavy "blur ghost" duplicate image is replaced by a light, soft shadow.
 */
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { InferEntrySchema } from 'astro:content'
import { getLangFromUrl, getLocalePath } from '@/i18n'
import { findSeriesBySlug, localizeSeries } from '@/lib/series'

import { FormattedDate, Icon } from 'astro-pure/user'

/**
 * `heroImage.src` 可以是本地图片（Astro `ImageMetadata`），也可以是远程封面
 * （BlogPost 传入的图床兜底封面，形如 `{ src: string, width, height }`），
 * 因此在 `InferEntrySchema` 基础上放宽 `heroImage` 的类型。
 */
type HeroImageData = Omit<InferEntrySchema<'blog'>, 'heroImage'> & {
  heroImage?: {
    src: ImageMetadata | string
    alt?: string
    inferSize?: boolean
    width?: number
    height?: number
    color?: string
  }
}

interface Props {
  data: HeroImageData
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  data: { title, description, draft, heroImage, publishDate, updatedDate, tags, language, series },
  remarkPluginFrontmatter
} = Astro.props

// 系列徽标（frontmatter series 字段），显示在 tag 左侧并跳转到系列详情页
const lang = getLangFromUrl(Astro.url)
const seriesMeta = series ? findSeriesBySlug(series) : undefined
const postSeries = seriesMeta ? localizeSeries(seriesMeta, lang) : undefined
---

{
  heroImage &&
    (typeof heroImage.src === 'string' ? (
      // 远程封面：Astro 要求远程图必须带 width/height（兜底封面自带真实尺寸）
      <Image
        alt={heroImage.alt || title}
        class='cover-image h-auto w-full max-w-[65ch] rounded-xl object-contain'
        fetchpriority='high'
        loading='eager'
        src={heroImage.src}
        width={heroImage.width ?? 1920}
        height={heroImage.height ?? 1080}
      />
    ) : (
      // 本地图片：TS 不会把三元窄化带入 spread，故显式断言
      <Image
        alt={heroImage.alt || title}
        class='cover-image h-auto w-full max-w-[65ch] rounded-xl object-contain'
        fetchpriority='high'
        loading='eager'
        src={heroImage.src as ImageMetadata}
        width={heroImage.width}
        height={heroImage.height}
      />
    ))
}

{draft ? <span class='text-red-500'>(Draft)</span> : null}

<div class='article-info max-lg:mx-auto'>
  <div class='flex flex-wrap gap-x-4 gap-y-2 text-xs leading-6 text-muted-foreground'>
    {/* Article date */}
    <div class='flex items-center gap-1'>
      <Icon name='calendar' class='size-5' />
      <FormattedDate class='font-sans' date={publishDate} />
      {
        updatedDate && (
          <div class='flex items-center gap-1'>
            <span> / </span>
            <span>
              Update
              <FormattedDate class='font-sans' date={updatedDate} />
            </span>
          </div>
        )
      }
    </div>
    {/* Times read */}
    <div class='flex items-center gap-1'>
      <Icon name='time' class='size-5' />
      {remarkPluginFrontmatter.minutesRead}
    </div>
    {
      // Language
      language && (
        <span class='flex items-center gap-1'>
          <Icon name='earth' class='size-5' />
          {language}
        </span>
      )
    }
    {
      // Series badge: 用酒红文字色与 tag 区分（不填充背景），点击进系列详情页
      postSeries && (
        <a
          class='inline-flex items-center gap-1 font-medium text-[#B7282E] no-underline transition-colors hover:underline hover:underline-offset-4 dark:text-red-400'
          href={getLocalePath(lang, `/series/${postSeries.slug}`)}
          data-astro-prefetch
        >
          <Icon name='list' class='size-4' />
          {postSeries.title}
        </a>
      )
    }
    {
      // Tags
      !!tags?.length && (
        <span class='flex items-center gap-1'>
          <Icon name='hashtag' class='size-5' />
          {tags.map((tag: string, i: number) => (
            <div>
              <a
                aria-label={`View more blogs with the tag ${tag}`}
                class='hover:underline hover:underline-offset-4'
                data-pagefind-filter='tag'
                href={`/tags/${tag}`}
              >
                {tag}
              </a>
              {i < tags.length - 1 && '/'}
            </div>
          ))}
        </span>
      )
    }
  </div>

  <h1 class='mt-4 text-2xl font-medium sm:mb-2 sm:mt-6 sm:text-3xl'>
    {title}
  </h1>

  <div class='mt-3 italic'>
    <blockquote class='text-sm text-muted-foreground'><q>{description}</q></blockquote>
    <slot name='description' />
  </div>
</div>

{/* Dividing line */}
<div class='mt-4 w-1/2 border-t max-md:mx-auto sm:mt-6 sm:w-1/3'></div>

<style>
  .cover-image {
    /* 轻量柔和投影，替代上游偏移的模糊副本 */
    box-shadow: 0 10px 28px -20px rgb(0 0 0 / 0.35);
  }
  :global(html.dark) .cover-image {
    box-shadow: 0 10px 28px -20px rgb(0 0 0 / 0.7);
  }
</style>
