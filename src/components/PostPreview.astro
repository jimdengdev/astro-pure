---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { render, type CollectionEntry, type CollectionKey } from 'astro:content'

import { cn } from 'astro-pure/utils'
import { Button, FormattedDate, Icon } from 'astro-pure/user'
import { getLangFromUrl, getLocalePath, getPostSlug } from '@/i18n'
import { findSeriesBySlug, localizeSeries } from '@/lib/series'
import { getRandomCover } from '@/utils/randomCover'

type Props<T extends CollectionKey> = {
  post: CollectionEntry<T>
  detailed?: boolean
  class?: string
}

const { post, detailed = false, class: className } = Astro.props
const { id, data } = post
const { remarkPluginFrontmatter } = await render(post)
const postDate = data.updatedDate ?? data.publishDate
type PreviewMetadata = {
  heroImage?: {
    src: ImageMetadata | string
    alt?: string
    inferSize?: boolean
    width?: number
    height?: number
    color?: string
  }
  language?: string
  pin?: boolean
}
const previewData = data as typeof data & Partial<PreviewMetadata>

// Fall back to a random remote cover (image CDN) when the post has no heroImage.
const fallbackCover = getRandomCover(String(id))
const cover: PreviewMetadata['heroImage'] | undefined =
  previewData.heroImage ?? (fallbackCover ? { ...fallbackCover, alt: data.title } : undefined)

// Link follows the current page's language: every slug exists under both
// /blog/<slug> and /zh/blog/<slug> (the route without a real translation
// falls back to the original content), so the UI language stays consistent.
// Route slug: frontmatter `link` takes priority over filename
const pageLang = getLangFromUrl(Astro.url)
const postHref = getLocalePath(pageLang, `/blog/${getPostSlug(post)}`)

// 系列归属（仅 blog 有 series 字段），用于在 tag 最左侧显示系列徽标
const seriesSlug = (data as { series?: string }).series
const seriesMeta = seriesSlug ? findSeriesBySlug(seriesSlug) : undefined
const postSeries = seriesMeta ? localizeSeries(seriesMeta, pageLang) : undefined
const seriesHref = postSeries ? getLocalePath(pageLang, `/series/${postSeries.slug}`) : undefined
---

<li
  class={cn('post-preview', className)}
  style={detailed &&
    previewData.heroImage?.color &&
    `--preview-highlight:color-mix(in srgb,${previewData.heroImage.color} 40%,hsl(var(--foreground)/var(--un-text-opacity,1)));
    --preview-highlight-bg:hsl(from ${previewData.heroImage.color} h s l/20%)`}
>
  <a
    class={cn(
      'block w-full relative group rounded-2xl border bg-background transition-colors ease-in-out px-5 py-2.5 hover:bg-muted hover:text-primary',
      detailed && 'max-sm:px-4 sm:py-5',
      detailed && cover && 'max-md:pt-24'
    )}
    href={postHref}
    data-astro-prefetch
  >
    {
      detailed && cover &&
        (typeof cover.src === 'string' ? (
          // 远程封面（Astro 要求远程图必须带 width/height）：CDN 兜底图自带真实尺寸，
          // frontmatter 里手写的远程图缺尺寸时用 16:9 兜底（CSS object-cover 决定实际裁剪）
          <Image
            alt={cover.alt || data.title || ''}
            class='cover-image absolute end-0 top-0 z-0 h-2/3 w-full rounded-2xl object-cover opacity-50 transition-opacity duration-300 group-hover:opacity-70 md:h-full md:w-3/5'
            loading='eager'
            src={cover.src}
            width={cover.width ?? 1920}
            height={cover.height ?? 1080}
          />
        ) : (
          // 本地图片：Astro 不会把三元窄化后的类型带入 spread，故显式断言
          <Image
            alt={cover.alt || data.title || ''}
            class='cover-image absolute end-0 top-0 z-0 h-2/3 w-full rounded-2xl object-cover opacity-50 transition-opacity duration-300 group-hover:opacity-70 md:h-full md:w-3/5'
            loading='eager'
            src={cover.src as ImageMetadata}
            width={cover.width}
            height={cover.height}
          />
        ))
    }
    <div
      class={cn('relative flex flex-col gap-1', !detailed && 'sm:flex-row sm:items-center')}
      style='z-index:1'
    >
      {postDate && <FormattedDate class='min-w-[95px] text-xs' date={postDate} />}

      {/* title */}
      <div class='flex justify-between flex-grow'>
        <div class={cn(detailed && 'font-bold text-[#B7282E] dark:text-red-400')}>
          {previewData.pin && <span class='text-primary me-1'>[Pin]</span>}
          {data.draft && <span class='text-red-500 me-1'>(Draft)</span>}
          {data.title}
        </div>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='preview-redirect my-1 stroke-muted-foreground group-hover:stroke-primary'
          ><line
            x1='5'
            y1='12'
            x2='19'
            y2='12'
            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
          ></line><polyline
            points='12 5 19 12 12 19'
            class='translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1'
          ></polyline></svg
        >
      </div>
      {
        detailed && (
          <>
            {/* desc */}
            <p
              class={cn(
                'line-clamp-2 text-sm text-muted-foreground sm:line-clamp-3',
                cover && 'sm:me-24'
              )}
            >
              {data.description}
            </p>
            <div class='py-2 flex items-center gap-2 text-sm italic leading-4 text-muted-foreground'>
              {/* reading time */}
              <span class='flex items-center gap-1'>
                <Icon name='time' class='size-4' />
                {remarkPluginFrontmatter.minutesRead}
              </span>
              {/* language */}
              {previewData.language && (
                <span class='flex items-center gap-1'>
                  <Icon name='earth' class='size-4' />
                  {previewData.language}
                </span>
              )}
            </div>
            {(postSeries || data.tags.length > 0) && (
              <object title='Tags' aria-label='Tags' aria-labelledby='Tags'>
                <ul class='tag-list mt-1 flex flex-wrap gap-2'>
                  {postSeries && seriesHref && (
                    <li>
                      {/* 系列徽标：与 tag 同形状，但酒红填充以区分，点击进系列详情页 */}
                      <a
                        class='series-badge inline-flex items-center rounded-xl border border-[#B7282E] bg-[#B7282E] px-2 py-1 text-sm text-white no-underline transition-colors hover:bg-[#9c2026] hover:text-white dark:border-red-400 dark:bg-red-400 dark:text-[#1c1917] dark:hover:bg-red-500 dark:hover:text-[#1c1917]'
                        href={seriesHref}
                        data-astro-prefetch
                      >
                        {postSeries.title}
                      </a>
                    </li>
                  )}
                  {data.tags.map((tag: string) => (
                    <li>
                      <Button as='a' title={tag} href={getLocalePath(pageLang, `/tags/${tag}`)} variant='pill' />
                    </li>
                  ))}
                </ul>
              </object>
            )}
          </>
        )
      }
    </div>
  </a>

  <style>
    .post-preview {
      --preview-highlight-final: var(
        --preview-highlight,
        hsl(var(--primary) / var(--un-text-opacity, 1))
      );
    }
    .post-preview:hover {
      & > a,
      & .tag-list a {
        background-color: var(
          --preview-highlight-bg,
          hsl(var(--muted) / var(--un-bg-opacity, 1))
        ) !important;
      }
      & > a,
      & .tag-list a:hover {
        color: var(--preview-highlight-final) !important;
      }
      & > a .preview-redirect {
        stroke: var(--preview-highlight-final) !important;
      }
    }
    /* 系列徽标在卡片 hover 时保持酒红外观，不被上面的高亮规则覆盖 */
    .post-preview:hover .series-badge {
      background-color: #b7282e !important;
      border-color: #b7282e !important;
      color: #fff !important;
    }
    :global(.dark) .post-preview:hover .series-badge {
      background-color: #f87171 !important;
      border-color: #f87171 !important;
      color: #1c1917 !important;
    }
    .cover-image {
      -webkit-mask-image: -webkit-linear-gradient(left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    }

    @media (max-width: 768px) {
      .cover-image {
        -webkit-mask-image: -webkit-linear-gradient(
          bottom,
          rgba(0, 0, 0, 0) 0%,
          rgba(0, 0, 0, 1) 100%
        );
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      }
    }
  </style>
</li>
