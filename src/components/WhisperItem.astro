---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import { getLocalePath, type Lang } from '@/i18n'
import type { WhisperView } from '@/lib/memos'

import { Button, FormattedDate } from 'astro-pure/user'

interface Props {
  /** 旧数据（英文模式）：内容集合条目 */
  entry?: CollectionEntry<'whispers'>
  /** memos 数据（中文模式）：适配后的视图 */
  item?: WhisperView
  lang: Lang
}

const { entry, item, lang } = Astro.props
const data = entry?.data
// 旧数据走 Astro 内容管线（主题 Markdown 配置）；memos 数据在适配层已渲染并消毒
let Content: Awaited<ReturnType<typeof render>>['Content'] | undefined
if (entry) ({ Content } = await render(entry))

const images = data ? data.images : (item?.images ?? [])
const tags = data ? data.tags : (item?.tags ?? [])
const expandText = lang === 'zh' ? '展开全部' : 'Show all'
const collapseText = lang === 'zh' ? '收起' : 'Collapse'
---

<li
  class='whispers-item'
  data-whisper-id={entry ? entry.id : item?.id}
  data-date={(data ? data.publishDate : item?.publishDate)?.toISOString()}
>
  {/* 时间 */}
  <div class='whispers-time'>
    <FormattedDate class='text-xs font-medium' date={data ? data.publishDate : item!.publishDate} />
  </div>

  {/* 时间轴：节点 + 竖线（竖线由全局 CSS 的 :last-child 规则控制） */}
  <div class='whispers-axis' aria-hidden='true'></div>

  {/* 内容卡片 */}
  <div class='whispers-body'>
    <article class='whispers-card'>
      {data?.title && <h2 class='mb-1 font-medium'>{data.title}</h2>}
      {
        entry && Content ? (
          <whispers-content
            data-collapsed
            data-expand-text={expandText}
            data-collapse-text={collapseText}
            class='text-sm leading-relaxed text-foreground/85'
          >
            <Content />
          </whispers-content>
        ) : item ? (
          <div class='flex items-start justify-between gap-2'>
            <whispers-content
              data-collapsed
              data-expand-text={expandText}
              data-collapse-text={collapseText}
              class='min-w-0 flex-1 text-sm leading-relaxed text-foreground/85'
              set:html={item.html}
            />
            <a
              href={item.sourceUrl}
              target='_blank'
              rel='noopener noreferrer'
              class='shrink-0 pt-0.5 text-xs text-muted-foreground transition-colors hover:text-primary'
            >
              {lang === 'zh' ? '查看原文 ↗' : 'View original ↗'}
            </a>
          </div>
        ) : null
      }

      {/* 内容超过 10 行时由脚本显示展开/收起按钮（样式对齐代码块折叠） */}
      <button type='button' hidden class='whispers-collapse-toggle mt-2'>
        <svg class='size-4' aria-hidden='true'>
          <use href='/icons/code.svg#mingcute-arrow-down-line' />
        </svg>
        <span data-label></span>
      </button>

      {
        images.length > 0 && (
          <ul class='mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3'>
            {images.map((src) => (
              <li>
                <a href={src} target='_blank' rel='noopener noreferrer' title={src}>
                  <img
                    src={src}
                    alt=''
                    loading='lazy'
                    class='h-28 w-full rounded-xl object-cover transition-opacity duration-200 hover:opacity-85 sm:h-32'
                  />
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        tags.length > 0 && (
          <div class='mt-2.5 flex flex-wrap items-center gap-2'>
            <ul class='flex flex-wrap gap-1.5'>
              {tags.map((tag) => (
                <li>
                  <Button
                    title={tag}
                    href={getLocalePath(lang, `/whispers/tags/${tag}`)}
                    variant='pill'
                  />
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </article>
  </div>
</li>

{
  /*
  全局样式：服务端渲染、无限滚动追加、客户端搜索结果三处共用，
  因此不能使用 scoped style（动态插入的 DOM 拿不到 scope hash）
*/
}
<style is:global>
  .whispers-timeline > .whispers-item {
    position: relative;
    display: flex;
    gap: 0.75rem;
  }
  .whispers-timeline > .whispers-item:last-child .whispers-body {
    padding-bottom: 0;
  }
  @media (min-width: 640px) {
    .whispers-timeline > .whispers-item {
      gap: 1rem;
    }
  }
  .whispers-item .whispers-time {
    width: 6.75rem;
    flex-shrink: 0;
    padding-top: 0.25rem;
    text-align: end;
  }
  .whispers-item .whispers-axis {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .whispers-item .whispers-axis::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.375rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background-color: hsl(var(--primary));
  }
  .whispers-item .whispers-axis::after {
    content: '';
    width: 1px;
    margin: 0.25rem 0;
    flex: 1;
    background-color: hsl(var(--border));
  }
  /* 最后一条不画竖线 */
  .whispers-timeline > .whispers-item:last-child .whispers-axis::after {
    display: none;
  }
  /* 手机端：日期横排显示在卡片上方，隐藏时间轴节点与竖线，正文获得全宽 */
  @media (max-width: 639px) {
    .whispers-timeline > .whispers-item {
      flex-wrap: wrap;
      row-gap: 0.25rem;
    }
    .whispers-item .whispers-time {
      width: 100%;
      flex-shrink: 0;
      padding-top: 0;
      text-align: start;
      white-space: nowrap;
    }
    .whispers-item .whispers-axis {
      display: none;
    }
    .whispers-item .whispers-body {
      flex: 0 0 100%;
      padding-bottom: 1rem;
    }
  }
  .whispers-item .whispers-body {
    min-width: 0;
    flex: 1;
    padding-bottom: 1.25rem;
  }
  .whispers-card {
    border-radius: 1rem;
    border: 1px solid hsl(var(--border));
    background-color: hsl(var(--background) / var(--un-bg-opacity, 1));
    padding: 0.75rem 1rem;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .whispers-card:hover {
    background-color: hsl(var(--muted) / var(--un-bg-opacity, 1));
  }
  @media (min-width: 640px) {
    .whispers-card {
      padding: 0.875rem 1.25rem;
    }
  }
  /* 内容默认折叠为 10 行，超出由 whispers-content 脚本提供展开/收起 */
  whispers-content {
    display: block;
    position: relative;
  }
  whispers-content[data-collapsed] {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 10;
    overflow: hidden;
  }
  /* 折叠时底部渐变淡出（对齐代码块的 collapse-fade） */
  whispers-content[data-collapsed]::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3.5rem;
    pointer-events: none;
    user-select: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      hsl(var(--background) / var(--un-bg-opacity, 1)) 90%
    );
  }
  /* 全宽展开/收起按钮条（对齐代码块的 collapse-toggle） */
  .whispers-collapse-toggle {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    column-gap: 0.3rem;
    padding: 0.375rem 0;
    border: 1px solid hsl(var(--border) / var(--un-border-opacity, 1));
    border-radius: 0.5rem;
    background-color: hsl(var(--card) / var(--un-bg-opacity, 1));
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
    user-select: none;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  /* hidden 属性被上面的 display:flex 覆盖，需要显式还原 */
  .whispers-collapse-toggle[hidden] {
    display: none;
  }
  .whispers-collapse-toggle:hover {
    color: hsl(var(--primary));
  }
  .whispers-collapse-toggle svg {
    transition: transform 0.2s ease;
  }
  .whispers-collapse-toggle.expanded svg {
    transform: rotate(180deg);
  }
</style>

<script>
  /**
   * 内容折叠：默认 data-collapsed（CSS 截断为 10 行），
   * 溢出时显示卡片内的展开/收起按钮。
   * 自定义元素对无限滚动追加的节点会自动升级生效。
   */
  class WhispersContent extends HTMLElement {
    private toggle: HTMLButtonElement | null = null
    private expanded = false
    private measured = false

    connectedCallback() {
      // 等一帧布局稳定后再测量溢出（含无限滚动追加的场景）
      requestAnimationFrame(() => this.check())
    }

    check() {
      if (!this.toggle) {
        this.toggle =
          this.closest('.whispers-card')?.querySelector<HTMLButtonElement>(
            '.whispers-collapse-toggle'
          ) ?? null
        if (this.toggle) this.toggle.onclick = () => this.switch()
      }
      if (!this.toggle) return
      // 已展开：保持按钮可见（文案为「收起」），无需重新检测
      if (this.expanded) return
      // 已确认为溢出的折叠状态：保持折叠，仅确保按钮可见
      if (this.measured && this.hasAttribute('data-collapsed')) {
        if (this.toggle.hidden) this.setLabel()
        this.toggle.hidden = false
        return
      }
      // 首次检测 / 复测（未折叠状态）：对比自然高度与折叠高度。
      // line-clamp 下溢出内容不参与布局，scrollHeight 测不到真实高度，
      // 因此临时移除折叠属性量出完整高度再恢复（同步执行，不会闪烁）
      this.removeAttribute('data-collapsed')
      const fullHeight = this.scrollHeight
      this.setAttribute('data-collapsed', '')
      const clampedHeight = this.clientHeight
      const overflow = fullHeight > clampedHeight + 1
      this.measured = true
      if (!overflow) {
        // 不超过 10 行：移除折叠（连带去掉虚化遮罩），不显示按钮
        this.removeAttribute('data-collapsed')
      }
      this.toggle.hidden = !overflow
      if (overflow) this.setLabel()
    }

    private setLabel() {
      if (!this.toggle) return
      this.toggle.classList.toggle('expanded', this.expanded)
      const label = this.toggle.querySelector<HTMLElement>('[data-label]')
      if (label) {
        label.textContent = this.expanded
          ? (this.dataset.collapseText ?? '收起')
          : (this.dataset.expandText ?? '展开全部')
      }
    }

    private switch() {
      this.expanded = !this.expanded
      if (this.expanded) {
        this.removeAttribute('data-collapsed')
      } else {
        this.setAttribute('data-collapsed', '')
      }
      this.setLabel()
    }
  }

  if (!customElements.get('whispers-content')) {
    customElements.define('whispers-content', WhispersContent)
  }

  // 字体加载完成 / 窗口尺寸变化后复测，避免误判溢出
  const recheckAll = () =>
    document.querySelectorAll('whispers-content').forEach((el) => (el as WhispersContent).check())
  document.fonts?.ready.then(recheckAll)
  window.addEventListener('load', recheckAll)
  window.addEventListener('resize', recheckAll)
</script>
