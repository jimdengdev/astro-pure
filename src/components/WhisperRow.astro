---
import type { CollectionEntry } from 'astro:content'

import { FormattedDate } from 'astro-pure/user'
import { getLocalePath, type Lang } from '@/i18n'

interface Props {
  entry: CollectionEntry<'whispers'>
  lang: Lang
}

const { entry, lang } = Astro.props
const { data } = entry

/**
 * 摘要：优先 frontmatter description，其次从正文提取纯文本
 * （去掉图片、链接与 Markdown 标记后截断）
 */
const excerpt = (
  data.description ??
  entry.body ??
  ''
)
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[#>*`_\-]+/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 90)
---

<li
  class='group relative rounded-2xl border bg-background px-5 py-2.5 transition-colors ease-in-out hover:bg-muted hover:text-primary max-sm:px-4 sm:py-3'
>
  <a
    class='block w-full'
    href={getLocalePath(lang, '/whispers')}
    data-astro-prefetch
    aria-label={excerpt}
  >
    <div class='relative flex flex-col gap-1 sm:flex-row sm:items-center'>
      <FormattedDate class='min-w-[9.5rem] text-xs' date={data.publishDate} />
      <div class='flex flex-1 items-center justify-between gap-2'>
        <span class='text-sm'>{excerpt}</span>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          class='size-4 shrink-0 stroke-muted-foreground transition-transform duration-300 group-hover:translate-x-0.5 group-hover:stroke-primary'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          aria-hidden='true'
        >
          <polyline points='9 18 15 12 9 6'></polyline>
        </svg>
      </div>
    </div>
  </a>
</li>
