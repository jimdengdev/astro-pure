---
import type { CollectionEntry } from 'astro:content'
import { getLocalePath, type Lang } from '@/i18n'
import type { WhisperView } from '@/lib/memos'

import { FormattedDate } from 'astro-pure/user'

interface Props {
  /** 旧数据（英文模式）：内容集合条目 */
  entry?: CollectionEntry<'whispers'>
  /** memos 数据（中文模式）：适配后的视图 */
  item?: WhisperView
  lang: Lang
}

const { entry, item, lang } = Astro.props
const data = entry?.data
const publishDate = data ? data.publishDate : item!.publishDate

/**
 * 摘要：旧数据优先 frontmatter description，其次从正文提取纯文本；
 * memos 数据在适配层已完成同样的剥离。
 */
const source = data?.description ?? entry?.body ?? item?.description ?? ''
const excerpt = source
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[#>*`_\-]+/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 90)
---

<li
  class='group relative rounded-2xl border bg-background px-5 py-2.5 transition-colors ease-in-out hover:bg-muted hover:text-primary max-sm:px-4 sm:py-3'
>
  <a
    class='block w-full'
    href={item ? getLocalePath(lang, `/whispers/m/${item.id}`) : getLocalePath(lang, '/whispers')}
    data-astro-prefetch
    aria-label={excerpt}
  >
    <div class='relative flex flex-col gap-1 sm:flex-row sm:items-center'>
      <FormattedDate class='min-w-[9.5rem] text-xs' date={publishDate} />
      <div class='flex flex-1 items-center justify-between gap-2'>
        <span class='text-sm'>{excerpt}</span>
        {/* 箭头：与首页博客条目同款 hover 动画（横线展开 + 右移） */}
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='preview-redirect my-1 shrink-0 stroke-muted-foreground group-hover:stroke-primary'
          aria-hidden='true'
        >
          <line
            x1='5'
            y1='12'
            x2='19'
            y2='12'
            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
          >
          </line>
          <polyline
            points='12 5 19 12 12 19'
            class='translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1'></polyline>
        </svg>
      </div>
    </div>
  </a>
</li>
