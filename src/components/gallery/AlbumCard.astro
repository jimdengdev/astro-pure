---
import type { GalleryAlbum } from '@/lib/gallery'
import { getLangFromUrl, getLocalePath } from '@/i18n'

interface Props {
  album: GalleryAlbum
}

const { album } = Astro.props
const lang = getLangFromUrl(Astro.url)
const photosLabel = lang === 'zh' ? '张照片' : 'photos'
---

<a
  href={getLocalePath(lang, `/gallery/${album.slug}`)}
  class='group relative block overflow-hidden rounded-2xl border bg-background no-underline transition-shadow duration-300 hover:shadow-lg'
  data-album-tags={album.tags.join(',')}
  data-astro-prefetch
>
  <div class='aspect-[4/3] overflow-hidden'>
    <img
      src={album.cover}
      alt={album.title}
      class='size-full object-cover transition-transform duration-500 group-hover:scale-105'
      loading='lazy'
    />
  </div>

  <div class='absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 via-black/40 to-transparent p-4 pt-10'>
    <h3 class='text-lg font-medium text-white'>{album.title}</h3>
    <p class='mt-0.5 line-clamp-1 text-sm text-white/80'>{album.description}</p>
    <div class='mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/70'>
      {album.location && <span>{album.location}</span>}
      <span aria-hidden='true'>·</span>
      <span>{album.photos.length} {photosLabel}</span>
      {album.tags.map((tag) => <span class='rounded-full bg-white/20 px-2 py-0.5'>{tag}</span>)}
    </div>
  </div>
</a>
