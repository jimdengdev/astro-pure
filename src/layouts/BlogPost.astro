---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import { getLangFromUrl, getLocalePath, getPostSlug } from '@/i18n'

import { MediumZoom } from 'astro-pure/advanced'
import { TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import ArticleBottom from '@/components/ArticleBottom.astro'
import Copyright from '@/components/Copyright.astro'
import ExpressDiagrams from '@/components/ExpressDiagrams.astro'
import Hero from '@/components/Hero.astro'
import { Comment } from '@/components/twikoo'
import { coverUrl, getRandomCover } from '@/utils/randomCover'
import config from 'virtual:config'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment
} = data

// Fall back to a random remote cover (image CDN) when the post has no heroImage.
const fallbackCover = heroImage ? undefined : getRandomCover(String(id))
const heroData = fallbackCover ? { ...data, heroImage: fallbackCover } : data

const socialImage = heroImage ? coverUrl(heroImage.src) : (fallbackCover?.src ?? config.socialCard)
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
const primaryColor = data.heroImage?.color ?? 'hsl(var(--primary) / var(--un-text-opacity))'

// 返回按钮跟随当前语言：/zh 文章 → /zh/blog，英文文章 → /blog
const pageLang = getLangFromUrl(Astro.url)
const backHref = getLocalePath(pageLang, '/blog')
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  highlightColor={primaryColor}
  back={backHref}
  hasSidebar={!!headings.length}
>
  {!!headings.length && <TOC {headings} slot='sidebar' />}

  <Hero data={heroData} {remarkPluginFrontmatter} slot='header'>
    {/* PageInfo（浏览量/评论数）为 Waline 专属，Twikoo 暂无对应 API，已移除 */}
  </Hero>

  <slot />

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright {data} />
    {/* Article recommend: pass route slug (link field first, fallback to post id) */}
    <ArticleBottom collections={posts} id={getPostSlug(Astro.props.post)} class='mt-3 sm:mt-6' />
    {/* Comment */}
    {!isDraft && enableComment && <Comment class='mt-3 sm:mt-6' />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}
{/* ```mermaid / ```infographic 代码块渲染为图形 */}
<ExpressDiagrams />
