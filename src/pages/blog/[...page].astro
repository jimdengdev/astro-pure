---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getBlogByLang } from '@/i18n'
import { getSeries, getSeriesStats, localizeSeries } from '@/lib/series'

import { Paginator } from 'astro-pure/components/pages'
import { getUniqueTagsWithCount, sortMDByDate } from 'astro-pure/server'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostPreview from '@/components/PostPreview.astro'
import SeriesBar from '@/components/SeriesBar.astro'
import config from '@/site-config'

export const prerender = true

export interface SeriesListItem {
  slug: string
  title: string
  description: string
  postCount: number
}

export const getStaticPaths = (async ({ paginate }) => {
  // English blog: only posts explicitly marked language: "English"
  // sortMDByDate 返回 CollectionEntry<CollectionKey>[]（blog/docs 联合），断言收窄到 blog
  const collections = sortMDByDate(await getBlogByLang('en')) as CollectionEntry<'blog'>[]
  const uniqueTags = getUniqueTagsWithCount(collections)
    .slice(0, 20)
    .map(([tag]) => tag)
  const collectionsCount = collections.length
  // 侧边栏系列列表（0 篇文章的系列不外显）
  const seriesList: SeriesListItem[] = getSeries()
    .map((s) => {
      const meta = localizeSeries(s, 'en')
      return {
        slug: s.slug,
        title: meta.title,
        description: meta.description,
        postCount: getSeriesStats(collections, s.slug).postCount
      }
    })
    .filter((s) => s.postCount > 0)
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { uniqueTags, collectionsCount, seriesList }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
  seriesList: SeriesListItem[]
}

const { page, uniqueTags, collectionsCount, seriesList } = Astro.props

const meta = {
  description: 'Some posts or archives of my blog',
  title: 'Blog'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← Previous Posts`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `Next Posts →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <Button title='Back' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 mt-6 text-3xl font-medium sm:mt-10'>Blog</h1>
    </div>
    {
      page.data.length === 0 ? (
        <p>No posts yet.</p>
      ) : (
        <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
          <section aria-label='Blog posts list' class='animate' id='content'>
            {/* header */}
            <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
              <span class='text-muted-foreground'>
                Page {page.currentPage} - Showing {page.data.length} of {collectionsCount} posts
              </span>
              <a aria-label='View all blog by years' href='/archives' data-astro-prefetch>
                View all posts by years →
              </a>
            </div>
            {/* posts */}
            <ul class='flex flex-col gap-y-4 text-start'>
              {page.data.map((post) => (
                <PostPreview {post} detailed />
              ))}
            </ul>
            <Paginator {...paginationProps} />
          </section>

          {/* sidebar */}
          {!!(uniqueTags.length || seriesList.length) && (
            <aside class='animate' id='sidebar'>
              {!!uniqueTags.length && (
                <>
                  <h2 class='mb-4 flex items-center text-lg font-medium'>
                    <Icon name='tag-2' class='me-2' />
                    Tags
                  </h2>
                  <ul class='text-bgColor flex flex-wrap gap-2'>
                    {
                      // Only show the 20 most-used tags in sidebar
                      uniqueTags.slice(0, 20).map((tag) => (
                        <li>
                          <Button title={tag} href={`/tags/${tag}`} variant='pill' />
                        </li>
                      ))
                    }
                  </ul>
                  <span class='mt-4 block sm:text-end'>
                    <a aria-label='View all blog categories' href='/tags' data-astro-prefetch>
                      View all →
                    </a>
                  </span>
                </>
              )}

              {/* 系列列表（条形）：系列名 + 描述 + 文章数 + 跳转标识 */}
              {!!seriesList.length && (
                <div class='mt-8'>
                  <h2 class='mb-4 flex items-center text-lg font-medium'>
                    <Icon name='list' class='me-2' />
                    Series
                  </h2>
                  <ul class='flex flex-col gap-2'>
                    {seriesList.map((s) => (
                      <li>
                        <SeriesBar
                          title={s.title}
                          description={s.description}
                          postCount={s.postCount}
                          postsLabel='articles'
                          href={`/series/${s.slug}`}
                        />
                      </li>
                    ))}
                  </ul>
                  <span class='mt-4 block sm:text-end'>
                    <a aria-label='View all series' href='/series' data-astro-prefetch>
                      View all →
                    </a>
                  </span>
                </div>
              )}
            </aside>
          )}
        </div>
      )
    }
  </main>
</PageLayout>
