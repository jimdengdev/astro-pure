---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import PhotoGrid from '@/components/gallery/PhotoGrid.astro'
import { Comment } from '@/components/twikoo'
import { getAlbums, localizeAlbum } from '@/lib/gallery'
import { useTranslations } from '@/i18n'

export const prerender = true

export async function getStaticPaths() {
  return getAlbums().map((album) => ({
    params: { slug: album.slug },
    props: { album }
  }))
}

// English route: localized fields (titleEn/...) with fallback to original content
const { album: rawAlbum } = Astro.props
const album = localizeAlbum(rawAlbum, 'en')
const t = useTranslations('en')

const meta = {
  description: album.description,
  title: album.title
}
---

<PageLayout {meta}>
  <Button title={t('gallery.back')} href='/gallery' variant='back' />
  <main class='mt-6 lg:mt-10'>
    {/* Hero: cover image with gradient overlay and album info */}
    <div id='content-header' class='animate'>
      <div class='relative overflow-hidden rounded-2xl' data-gallery-banner>
        <img src={album.cover} alt={album.title} class='h-64 w-full object-cover brightness-75 sm:h-80 transition-transform duration-500 hover:scale-[1.02]' />
        <div
          class='absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/20'
        ></div>
        <div class='absolute inset-x-0 bottom-0 p-5 sm:p-7' style='text-shadow: 0 1px 4px rgba(0,0,0,0.7)'>
          <h1 class='text-2xl font-semibold text-white sm:text-3xl'>{album.title}</h1>
          <p class='mt-1 text-sm text-white/90'>{album.description}</p>
          <div class='mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-white/85'>
            <span>{album.date}</span>
            {album.location && (
              <>
                <span aria-hidden='true'>·</span>
                <span>{album.location}</span>
              </>
            )}
            <span aria-hidden='true'>·</span>
            <span>{album.photos.length} {t('gallery.photos')}</span>
            {album.tags.map((tag) => (
              <span class='rounded-full bg-white/30 px-2 py-0.5 font-medium'>{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </div>

    {/* Photo grid + lightbox */}
    <section id='content' class='animate mt-8' aria-label='Photo list'>
      <PhotoGrid photos={album.photos} />
    </section>

    {/* Comments (per-album toggle, default on) */}
    {album.comments !== false && <Comment class='mt-10' />}
  </main>
</PageLayout>
