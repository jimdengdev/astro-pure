---
import links from '@/public/links.json'

import PageLayout from '@/layouts/CommonPage.astro'
import FriendList from '@/components/links/FriendList.astro'
import config from 'virtual:config'

const headings = [
  { depth: 2, slug: 'common-links', text: 'Friend Links' },
  { depth: 2, slug: 'special-links', text: 'Special Links' },
  { depth: 2, slug: 'apply-links', text: 'Apply for a Link' }
]

const { friends } = links
const linksConf = config.integ.links

// Site info YAML (single source: applyTip in site.config.ts)
const tip = Object.fromEntries(linksConf.applyTip.map((t) => [t.name, t.val]))
const applyYaml = [
  `- site: ${tip.Name ?? config.title}`,
  `  url: ${tip.Link ?? ''}`,
  `  owner: ${config.author}`,
  `  desc: ${tip.Desc ?? ''}`,
  `  image: ${tip.Avatar ?? ''}`
].join('\n')
---

<PageLayout title='Links' {headings} comment>
  <p>Welcome to exchange friend links! Listed in no particular order (shuffled).</p>
  <h2 id='common-links'>Friend Links</h2>
  <FriendList list={friends[0]} />
  <h2 id='special-links'>Special Links</h2>
  <FriendList list={friends[2]} />

  <h2 id='apply-links'>Apply for a Link</h2>
  <p>Leave a comment below with this site's info:</p>
  <div class='not-prose group relative my-4'>
    <button
      id='copy-apply-yaml'
      type='button'
      class='absolute end-2 top-2 z-10 rounded-md bg-muted px-2.5 py-1 text-xs text-muted-foreground transition-colors hover:text-primary'
    >
      Copy
    </button>
    <pre class='overflow-x-auto rounded-xl bg-muted p-4 text-sm leading-6'><code id='apply-yaml'>{applyYaml}</code></pre>
  </div>
  <p>
    Copy the info above and paste it into the comment section below, or email it to{' '}
    <a href='mailto:jimdengdev@qq.com'>jimdengdev@qq.com</a>. I'll update it as soon as I see it.
  </p>

  <p>Requirements:</p>
  <ul>
    <li>You have linked to this site on your website</li>
    <li>Your site is alive with a formal domain</li>
    <li>At least 5 original articles, updated within the last year</li>
    <li>Content does not violate any laws</li>
  </ul>
</PageLayout>

<script>
  // Copy the apply-for-link YAML template (Clipboard API first, execCommand fallback)
  const copyBtn = document.getElementById('copy-apply-yaml')
  const yamlCode = document.getElementById('apply-yaml')

  async function copyText(text: string): Promise<boolean> {
    if (window.isSecureContext && navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text)
        return true
      } catch {
        /* fall through to execCommand */
      }
    }
    try {
      const area = document.createElement('textarea')
      area.value = text
      area.style.position = 'fixed'
      area.style.opacity = '0'
      document.body.appendChild(area)
      area.select()
      // execCommand 已废弃，但作为 navigator.clipboard 不可用时的兜底保留；
      // 断言绕开 deprecated 诊断
      const ok = (document as any).execCommand('copy') as boolean
      document.body.removeChild(area)
      return ok
    } catch {
      return false
    }
  }

  copyBtn?.addEventListener('click', async () => {
    const text = yamlCode?.innerText ?? ''
    const ok = await copyText(text)
    if (copyBtn) {
      copyBtn.textContent = ok ? 'Copied ✓' : 'Copy failed'
      setTimeout(() => (copyBtn.textContent = 'Copy'), 1500)
    }
  })
</script>
