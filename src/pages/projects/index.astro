---
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'others', text: 'Others' }
]
---

<PageLayout title='Projects' {headings}>
  <p>Here are the projects I maintain or contribute to.</p>

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '🚀 Personal Blog',
        description:
          'A personal blog built with Astro, recording backend engineering and AI application notes',
        links: [
          { type: 'github', href: 'https://github.com/jimdengdev' },
          { type: 'site', href: 'https://jimdeng.com/' }
        ]
      }
    ]}
  />

  <h2 id='others'>Others</h2>
  <p>
    For more projects, visit my <a href='https://github.com/jimdengdev' target='_blank'
      >GitHub profile</a
    >.
  </p>
  <Button title='Visit GitHub' class='w-fit' href='https://github.com/jimdengdev' variant='ahead'>
    <Icon class='size-5' name='github' slot='before' />
  </Button>
</PageLayout>
