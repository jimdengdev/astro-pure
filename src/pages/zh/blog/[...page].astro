---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator } from 'astro-pure/components/pages'
import { getUniqueTagsWithCount, sortMDByDate } from 'astro-pure/server'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostPreview from '@/components/PostPreview.astro'
import SeriesBar from '@/components/SeriesBar.astro'
import { getLangFromUrl, useTranslations, getLocalePath, getBlogByLang } from '@/i18n'
import { getSeries, getSeriesStats, localizeSeries } from '@/lib/series'
import config from '@/site-config'

export const prerender = true

export interface SeriesListItem {
  slug: string
  title: string
  description: string
  postCount: number
}

export const getStaticPaths = (async ({ paginate }) => {
  // Chinese blog: posts without an English language tag (default = Chinese)
  // sortMDByDate 返回 CollectionEntry<CollectionKey>[]（blog/docs 联合），断言收窄到 blog
  const collections = sortMDByDate(await getBlogByLang('zh')) as CollectionEntry<'blog'>[]
  const uniqueTags = getUniqueTagsWithCount(collections)
    .slice(0, 20)
    .map(([tag]) => tag)
  const collectionsCount = collections.length
  // 侧边栏系列列表（0 篇文章的系列不外显）
  const seriesList: SeriesListItem[] = getSeries()
    .map((s) => {
      const meta = localizeSeries(s, 'zh')
      return {
        slug: s.slug,
        title: meta.title,
        description: meta.description,
        postCount: getSeriesStats(collections, s.slug).postCount
      }
    })
    .filter((s) => s.postCount > 0)
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { uniqueTags, collectionsCount, seriesList }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
  seriesList: SeriesListItem[]
}

const { page, uniqueTags, collectionsCount, seriesList } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const meta = {
  description: t('blog.description'),
  title: t('blog.title')
}

// paginate() 生成的 page.url 已包含 /zh 前缀（路由位于 zh/blog/ 目录下），直接使用
const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: t('blog.prev'),
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: t('blog.next'),
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <Button title={t('common.back')} href='/zh' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 mt-6 text-3xl font-medium sm:mt-10'>{t('blog.title')}</h1>
    </div>
    {
      page.data.length === 0 ? (
        <p>{t('blog.no_posts')}</p>
      ) : (
        <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
          <section aria-label='Blog posts list' class='animate' id='content'>
            <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
              <span class='text-muted-foreground'>
                {t('blog.page')} {page.currentPage} - {t('blog.showing')} {page.data.length} / {collectionsCount} {t('blog.posts')}
              </span>
              <a aria-label='View all blog by years' href={getLocalePath(lang, '/archives')} data-astro-prefetch>
                {t('blog.view_all')}
              </a>
            </div>
            <ul class='flex flex-col gap-y-4 text-start'>
              {page.data.map((post) => (
                <PostPreview {post} detailed />
              ))}
            </ul>
            <Paginator {...paginationProps} />
          </section>

          {!!(uniqueTags.length || seriesList.length) && (
            <aside class='animate' id='sidebar'>
              {!!uniqueTags.length && (
                <>
                  <h2 class='mb-4 flex items-center text-lg font-medium'>
                    <Icon name='tag-2' class='me-2' />
                    {t('blog.tags')}
                  </h2>
                  <ul class='text-bgColor flex flex-wrap gap-2'>
                    {uniqueTags.slice(0, 20).map((tag) => (
                      <li>
                        <Button
                          title={tag}
                          href={getLocalePath(lang, `/tags/${tag}`)}
                          variant='pill'
                        />
                      </li>
                    ))}
                  </ul>
                  <span class='mt-4 block sm:text-end'>
                    <a
                      aria-label='View all blog categories'
                      href={getLocalePath(lang, '/tags')}
                      data-astro-prefetch
                    >
                      {t('blog.view_all_tags')}
                    </a>
                  </span>
                </>
              )}

              {/* 系列列表（条形）：系列名 + 描述 + 文章数 + 跳转标识 */}
              {!!seriesList.length && (
                <div class='mt-8'>
                  <h2 class='mb-4 flex items-center text-lg font-medium'>
                    <Icon name='list' class='me-2' />
                    {t('series.title')}
                  </h2>
                  <ul class='flex flex-col gap-2'>
                    {seriesList.map((s) => (
                      <li>
                        <SeriesBar
                          title={s.title}
                          description={s.description}
                          postCount={s.postCount}
                          postsLabel={t('series.posts')}
                          href={getLocalePath(lang, `/series/${s.slug}`)}
                        />
                      </li>
                    ))}
                  </ul>
                  <span class='mt-4 block sm:text-end'>
                    <a
                      aria-label='View all series'
                      href={getLocalePath(lang, '/series')}
                      data-astro-prefetch
                    >
                      {t('blog.view_all_tags')}
                    </a>
                  </span>
                </div>
              )}
            </aside>
          )}
        </div>
      )
    }
  </main>
</PageLayout>
