---
import { getLangFromUrl, getLocalePath, useTranslations } from '@/i18n'
import { listWhispers, listWhispersPage, WHISPERS_PAGE_SIZE, type WhisperView } from '@/lib/memos'

import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import WhisperItem from '@/components/WhisperItem.astro'
import WhisperLoadMore from '@/components/WhisperLoadMore.astro'
import WhisperSearch from '@/components/WhisperSearch.astro'

export const prerender = false

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// 旧数字分页（/zh/whispers/2）已被无限滚动替代：统一回到第 1 页
if (Astro.params.page !== undefined) {
  Astro.cache.set(false)
  return Astro.redirect(getLocalePath(lang, '/whispers'), 302)
}

// 首屏：单次请求最新一页（20 条），后续滚动经 /zh/whispers/more 游标翻页
let items: WhisperView[] = []
let nextPageToken: string | undefined
let unavailable = false
try {
  const page = await listWhispersPage()
  items = page.items
  nextPageToken = page.nextPageToken
} catch {
  // 失败原因已由 listWhispersPage 抛出；这里走 listWhispers 的降级链路（本地兜底，无游标）
  unavailable = true
  try {
    items = await listWhispers({ limit: WHISPERS_PAGE_SIZE, lang })
  } catch {
    // 保持空列表，页面显示不可用提示
  }
}
if (unavailable) {
  Astro.cache.set(false)
} else {
  Astro.cache.set({ maxAge: 300, swr: 30 })
}

const moreBase = getLocalePath(lang, '/whispers/more')
const nextUrl = nextPageToken
  ? `${moreBase}?pageToken=${encodeURIComponent(nextPageToken)}`
  : undefined

const meta = {
  title: t('whispers.title'),
  description: t('whispers.description')
}

// 搜索索引不再随首屏内嵌（避免每次渲染拉全量），改为用户搜索时按需加载
const indexUrl = getLocalePath(lang, '/whispers/search-index.json')
---

<PageLayout {meta}>
  <Button title='Back' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-3 mt-6 text-3xl font-medium sm:mt-10'>{t('whispers.title')}</h1>
      {/* 描述在左、搜索条在右（同一行），窄屏时自动堆叠 */}
      <div class='flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4'>
        <p class='shrink-0 text-sm text-muted-foreground'>{t('whispers.description')}</p>
        {
          items.length > 0 && (
            <WhisperSearch indexUrl={indexUrl} lang={lang} class='sm:w-auto sm:max-w-md' />
          )
        }
      </div>
    </div>

    <section id='content' class='animate mt-8' aria-label='Moments timeline'>
      {
        unavailable ? (
          <p>{t('whispers.unavailable')}</p>
        ) : items.length === 0 ? (
          <p>{t('whispers.empty')}</p>
        ) : (
          <>
            <ol
              id='whispers-results'
              class='whispers-timeline flex flex-col'
              data-whispers-timeline
            >
              {items.map((item) => (
                <WhisperItem item={item} lang={lang} />
              ))}
            </ol>
            <WhisperLoadMore nextUrl={nextUrl} lang={lang} />
          </>
        )
      }
    </section>
  </main>
</PageLayout>
