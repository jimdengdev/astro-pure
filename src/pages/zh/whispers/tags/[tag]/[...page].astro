---
import { getLangFromUrl, getLocalePath, useTranslations } from '@/i18n'
import { countWhisperTags, listWhispers, type WhisperView } from '@/lib/memos'

import { Paginator } from 'astro-pure/components/pages'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import WhisperItem from '@/components/WhisperItem.astro'

export const prerender = false

const PAGE_SIZE = 10

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const { tag } = Astro.params

// SSR：按需从 memos 拉取
let items: WhisperView[] = []
let unavailable = false
try {
  items = await listWhispers({ lang })
} catch {
  // 失败原因已由 listWhispers 统一记录
  unavailable = true
  Astro.cache.set(false)
}
if (!unavailable) Astro.cache.set({ maxAge: 300, swr: 30 })

// 标签必须真实存在，否则 404
let notFound = false
if (!tag || !countWhisperTags(items).some(([known]) => known === tag)) {
  notFound = true
}

const filtered = tag && !notFound ? items.filter((item) => item.tags.includes(tag)) : []
const total = filtered.length
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE))

// /zh/whispers/tags/{tag} → 第 1 页；/zh/whispers/tags/{tag}/3 → 第 3 页
const rawPage = Astro.params.page
let page = 1
if (rawPage !== undefined) {
  const parsed = Number.parseInt(rawPage, 10)
  if (Number.isInteger(parsed) && parsed >= 1 && String(parsed) === rawPage) page = parsed
  else notFound = true
}
if (page > totalPages) notFound = true
if (notFound) {
  Astro.response.status = 404
  Astro.cache.set(false)
}

const slice = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)
const tagBase = () => getLocalePath(lang, `/whispers/tags/${tag}`)

const meta = {
  title: `${t('whispers.tags')}: ${tag}`,
  description: t('whispers.tags_desc')
}

const paginationProps = {
  ...(page > 1 && {
    prevUrl: { text: '← Previous', url: `${tagBase()}${page - 1 > 1 ? `/${page - 1}` : ''}` }
  }),
  ...(page < totalPages && {
    nextUrl: { text: 'Next →', url: `${tagBase()}/${page + 1}` }
  })
}
---

<PageLayout {meta}>
  <Button title='Back' href={getLocalePath(lang, '/whispers')} variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 flex items-end gap-x-2 text-3xl font-medium'>
        {t('whispers.tags')}:
        <span class='text-2xl'>#{tag}</span>
      </h1>
      <span class='mt-4 block text-sm text-muted-foreground'>
        <a
          href={getLocalePath(lang, '/whispers/tags')}
          class='hover:underline hover:underline-offset-4'
        >
          {t('whispers.view_all_tags')}
        </a>
      </span>
    </div>

    <section id='content' class='animate mt-8' aria-label='Moments with tag'>
      {
        unavailable ? (
          <p>{t('whispers.unavailable')}</p>
        ) : notFound ? (
          <p>404</p>
        ) : slice.length === 0 ? (
          <p>{t('whispers.empty')}</p>
        ) : (
          <>
            <ol class='whispers-timeline flex flex-col' data-whispers-timeline>
              {slice.map((item) => (
                <WhisperItem item={item} lang={lang} />
              ))}
            </ol>
            <Paginator {...paginationProps} />
          </>
        )
      }
    </section>
  </main>
</PageLayout>
